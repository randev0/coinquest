generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  budgets       Budget[]
  rules         Rule[]
  insights      Insight[]
  importBatches ImportBatch[]
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  name      String
  type      AccountType
  currency  String      @default("MYR")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  importBatches ImportBatch[]

  @@unique([userId, name])
}

enum AccountType {
  CARD
  EWALLET
  CASH
  BANK
}

model Transaction {
  id                    String               @id @default(cuid())
  accountId             String
  importBatchId         String?
  postedDate            DateTime
  description           String
  normalizedDescription String
  amount                Decimal              @db.Decimal(12, 2)
  direction             TransactionDirection
  merchantGuess         String?
  categoryId            String?
  notes                 String?
  fingerprint           String
  rawLine               String?
  isDuplicate           Boolean              @default(false)
  isSubscription        Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])

  @@index([accountId])
  @@index([postedDate])
  @@index([fingerprint])
  @@index([categoryId])
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String?
  color    String?
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())

  transactions Transaction[]
  rules        Rule[]
  budgets      Budget[]
}

model Rule {
  id         String    @id @default(cuid())
  userId     String
  priority   Int       @default(100)
  matchType  MatchType
  pattern    String
  categoryId String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId, priority])
}

enum MatchType {
  CONTAINS
  REGEX
  EXACT
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId, month])
}

model Insight {
  id        String   @id @default(cuid())
  userId    String
  month     String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model ImportBatch {
  id           String       @id @default(cuid())
  userId       String
  accountId    String
  filename     String
  month        String
  status       ImportStatus @default(PENDING)
  totalRows    Int          @default(0)
  importedRows Int          @default(0)
  skippedRows  Int          @default(0)
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, month])
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
